#include <iostream>
using namespace std;

int main() {
    int grade;
    int passed = 0;
    int failed = 0;
    int student = 1;

    while (student <= 10) {
        cout << "Enter grade of student " << student << ": ";
        cin >> grade;

        if (grade >= 75) {
            cout << "Passed!" << endl;
            passed++;
        } else {
            cout << "Failed!" << endl;
            failed++;
        }

        student++;
    }

    cout << "\n===== STUDENT RESULTS =====" << endl;
    cout << "Total Passed Students: " << passed << endl;
    cout << "Total Failed Students: " << failed << endl;

    return 0;
}
